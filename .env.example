NEXT_PUBLIC_SITE_URL=https://karcinauto.com

# --- GoHighLevel ---
# PREFERRED: GHL API v2 (full fidelity — upserts contact + note + tags + optional pipeline).
# GHL_API_KEY = a Private Integration token (Settings -> Private Integrations).
#   Scopes: contacts.write, contacts.readonly, opportunities.write, opportunities.readonly.
# GHL_LOCATION_ID = the sub-account / location id.
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional: drop every lead into a pipeline as an opportunity.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# FALLBACK: inbound webhook (used only if the API token above is not set):
NEXT_PUBLIC_GHL_FORM_WEBHOOK_URL=

# --- Retell (Voice AI receptionist "Ava") ---
# Provision/update the agent with scripts/provision-retell.mjs (see voice-ai/README.md).
# RETELL_API_KEY is the existing Omniscient Retell key (same account used for the DeNovo build).
RETELL_API_KEY=
# Inbound agent ("Ava"):
RETELL_AGENT_ID=
RETELL_LLM_ID=
# Outbound agent ("Ava (Outbound)"):
RETELL_OUTBOUND_AGENT_ID=
RETELL_OUTBOUND_LLM_ID=
# Outbound caller ID — a number registered in Retell:
RETELL_FROM_NUMBER=
# Shared secret to authorize POST /api/retell/place-call (x-karcin-secret header):
OUTBOUND_TRIGGER_SECRET=
# Secret guarding the post-call webhook (set on agents as ?key=...). Generate: openssl rand -hex 16
RETELL_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
